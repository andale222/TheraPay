<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TheraPay.UI.ViewModels"
             xmlns:dataGrid="using:Avalonia.Controls"
             x:Class="TheraPay.UI.Views.InvoicesView"
             x:DataType="vm:InvoicesViewModel">

  <ScrollViewer>
    <Grid Margin="16"
          ColumnDefinitions="2*,280"
          RowDefinitions="Auto,*"
          ColumnSpacing="16"
          RowSpacing="12">

      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
        <TextBlock Text="Rechnungen" FontSize="20" FontWeight="Bold" />

        <Grid ColumnDefinitions="*,180" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Watermark="Filter: Rechnung, Patient, Status"
                   Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding StatusFilters}"
                    SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" />
        </Grid>

        <dataGrid:DataGrid ItemsSource="{Binding Invoices}"
                           SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}"
                           AutoGenerateColumns="False"
                           IsReadOnly="True"
                           MinHeight="280"
                           MaxHeight="360"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           ScrollViewer.VerticalScrollBarVisibility="Auto">
          <dataGrid:DataGrid.Styles>
            <Style Selector="DataGridRow">
              <Setter Property="Background" Value="{ReflectionBinding StatusBackground}" />
            </Style>
            <Style Selector="DataGridCell">
              <Setter Property="Background" Value="{ReflectionBinding StatusBackground}" />
            </Style>
          </dataGrid:DataGrid.Styles>
          <dataGrid:DataGrid.Columns>
            <dataGrid:DataGridTextColumn Header="Datum" Binding="{Binding Date}" Width="Auto" />
            <dataGrid:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
            <dataGrid:DataGridTextColumn Header="Patient" Binding="{Binding Patient}" Width="*" />
            <dataGrid:DataGridTextColumn Header="Gesamtbetrag" Binding="{Binding TotalAmount}" Width="Auto" />
            <dataGrid:DataGridTextColumn Header="InvoiceID" Binding="{Binding InvoiceId}" Width="*" />
          </dataGrid:DataGrid.Columns>
        </dataGrid:DataGrid>
      </StackPanel>

      <Border Grid.Row="0"
              Grid.Column="1"
              Padding="12"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock Text="Aktionen" FontSize="16" FontWeight="Bold" />
          <Button Content="Draft bearbeiten"
                  Command="{Binding EditDraftCommand}"
                  MinWidth="220"
                  HorizontalAlignment="Stretch"
                  Background="#71CE82" />
          <Button Content="Draft Löschen"
                  Command="{Binding DeleteDraftCommand}"
                  MinWidth="220"
                  HorizontalAlignment="Stretch"
                  Background="#D9534F"
                  Foreground="White" />
          <Button Content="Rechnung erneut drucken"
                  Command="{Binding PrintInvoiceCommand}"
                  MinWidth="220"
                  HorizontalAlignment="Stretch"
                  Background="#F2B134" />
          <Button Content="Zurück"
                  Command="{Binding NavigateHomeViewCommand}"
                  MinWidth="220"
                  HorizontalAlignment="Stretch"
                  Background="#FF6B6B" />
          <TextBlock Text="{Binding StatusMessage}"
                     TextWrapping="Wrap"
                     Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1"
              Grid.Column="0"
              Padding="12"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock Text="Rechnungsdetails" FontSize="16" FontWeight="Bold" />

          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Status:" FontWeight="Bold" VerticalAlignment="Center" />
                <Border Background="{Binding InvoiceStatusBackground}"
                        Padding="6,3"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding InvoiceStatusText}" />
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Rechnungsnr.:" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding InvoiceNumber}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Status ändern:" FontWeight="Bold" VerticalAlignment="Center" />
                <ComboBox Width="150"
                          ItemsSource="{Binding EditableStatusOptions}"
                          SelectedItem="{Binding SelectedEditableInvoiceStatus, Mode=TwoWay}"
                          IsEnabled="{Binding IsInvoiceStatusEditable}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="24">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Fällig am:" FontWeight="Bold" />
                <TextBlock Text="{Binding InvoiceDueDate}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Gesamt:" FontWeight="Bold" />
                <TextBlock Text="{Binding InvoiceTotalAmount}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="8">
              <TextBlock Text="Positionen" FontSize="15" FontWeight="Bold" Margin="0,8,0,0" />
              <dataGrid:DataGrid ItemsSource="{Binding Positions}"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 MinHeight="220"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                <dataGrid:DataGrid.Columns>
                  <dataGrid:DataGridTextColumn Header="Datum" Binding="{Binding Date}" Width="Auto" />
                  <dataGrid:DataGridTextColumn Header="Ziffern" Binding="{Binding BillingNumbers}" Width="Auto" />
                  <dataGrid:DataGridTextColumn Header="Betrag" Binding="{Binding Amount}" Width="Auto" />
                  <dataGrid:DataGridTextColumn Header="ID" Binding="{Binding Position}" Width="*" />
                </dataGrid:DataGrid.Columns>
              </dataGrid:DataGrid>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Grid.Row="1"
              Grid.Column="1"
              Padding="12"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1"
              CornerRadius="8"
              VerticalAlignment="Top">
        <StackPanel Spacing="8">
          <TextBlock Text="Patientendetails" FontSize="16" FontWeight="Bold" />
          <TextBlock Text="{Binding PatientDetailsIdAndName, StringFormat='ID + Name: {0}'}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PatientDateOfBirth, StringFormat='Geburtsdatum: {0}'}" />
          <TextBlock Text="{Binding PatientInsuranceStatus, StringFormat='Typ: {0}'}" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
