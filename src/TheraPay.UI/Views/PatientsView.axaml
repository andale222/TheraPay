<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TheraPay.UI.ViewModels"
             xmlns:domain="using:TheraPay.Domain"
             xmlns:dataGrid="using:Avalonia.Controls"
             x:Class="TheraPay.UI.Views.PatientsView"
             x:DataType="vm:PatientsViewModel">

  <StackPanel Margin="16" Spacing="8">
    <TextBlock Text="Patient hinzufügen/bearbeiten" FontSize="18"/>

    <Grid ColumnDefinitions="Auto,*" Margin="16" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="16">

    <StackPanel Orientation="Horizontal" Grid.Row= "0" Grid.Column="0" Spacing="8">
      <StackPanel Orientation="Vertical" Grid.Row= "0" Grid.Column="0" Spacing="8">
       <TextBlock Text="Vorname" FontSize="15"/>
       <TextBox Width="160" Watermark="First name" Text="{Binding FirstName}"/>
      </StackPanel>
      <StackPanel Orientation="Vertical" Grid.Row= "0" Grid.Column="0" Spacing="8">
       <TextBlock Text="Nachname" FontSize="15"/>
       <TextBox Width="160" Watermark="First name" Text="{Binding LastName}"/>
      </StackPanel>
      <StackPanel Orientation="Vertical" Grid.Row= "0" Grid.Column="0" Spacing="8">
       <TextBlock Text="Patienten ID" FontSize="15"/>
       <TextBox Width="160" Watermark="First name" Text="{Binding PatientID}"/>
      </StackPanel>
      <StackPanel Orientation="Vertical" Grid.Row= "0" Grid.Column="0" Spacing="8">
       <TextBlock Text="IC-Diagnose" FontSize="15"/>
       <TextBox Width="160" Watermark="ICD code"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Grid.Row= "1" Grid.Column="0" Spacing="8">
      <StackPanel Orientation="Vertical" Grid.Row= "1" Grid.Column="0" Spacing="8">
       <TextBlock Text="Straße + Hausnr." FontSize="15"/>
       <TextBox Width="160" Watermark="Straße + Hausnr." Text="{Binding }"/>
      </StackPanel>
      <StackPanel Orientation="Vertical" Grid.Row= "1" Grid.Column="0" Spacing="8">
       <TextBlock Text="PLZ" FontSize="15"/>
       <TextBox Width="160" Watermark="PLZ" Text="{Binding }"/>
      </StackPanel>
      <StackPanel Orientation="Vertical" Grid.Row= "1" Grid.Column="0" Spacing="8">
       <TextBlock Text="Ort" FontSize="15"/>
       <TextBox Width="160" Watermark="Ort" Text="{Binding }"/>
      </StackPanel>
      <StackPanel Orientation="Vertical" Grid.Row= "1" Grid.Column="0" Spacing="8">
       <TextBlock Text="Land" FontSize="15"/>
       <TextBox Width="160" Watermark="Land" Text="{Binding }"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Grid.Row= "2" Grid.Column="0" Spacing="8">
      <StackPanel Orientation="Vertical" Grid.Row= "2" Grid.Column="0" Spacing="8">
       <TextBlock Text="E-Mail" FontSize="15"/>
       <TextBox Width="160" Watermark="E-Mail" />
      </StackPanel>
      <StackPanel Orientation="Vertical" Grid.Row= "2" Grid.Column="0" Spacing="8">
       <TextBlock Text="Telefonnr." FontSize="15"/>
       <TextBox Width="160" Watermark="Festnetznummer" />
      </StackPanel>
      <StackPanel Orientation="Vertical" Grid.Row= "2" Grid.Column="0" Spacing="8">
       <TextBlock Text="Versicherungsart" FontSize="15"/>
       <ComboBox Width="160"
                 ItemsSource="{Binding InsuranceStatuses}"
                 SelectedItem="{Binding SelectedInsuranceStatus, Mode=TwoWay}" />
      </StackPanel>
    </StackPanel>



    <StackPanel Orientation="Horizontal" Grid.Row= "3" Grid.Column="0" Spacing="8">
      <StackPanel Orientation="Vertical" Grid.Row= "3" Grid.Column="0" Spacing="8">
       <TextBlock Text="Notizen" FontSize="15"/>
       <TextBox Width="500" Height="150" AcceptsReturn="True" TextWrapping="Wrap" Watermark="Notizen" />
      </StackPanel>
    </StackPanel>


    <StackPanel Orientation="Vertical" Spacing="8" Margin="8" Grid.Column="0" Grid.Row= "4" >
      <TextBlock Text="Status:" FontSize="15"/>
      <RadioButton GroupName="PatientenStatus" Content="aktiv"  IsChecked="True"/>
      <RadioButton GroupName="PatientenStatus" Content="inaktiv" />
    </StackPanel>
    <StackPanel Orientation="Vertical" Grid.Row= "4" Grid.Column="1" Spacing="8">
      <Button Content="Daten prüfen" Command="{Binding CheckDataCommand}" Background="#FAAC2D" HorizontalAlignment="Right"/>
      <Button Content="Hinzufügen" Command="{Binding AddPatientCommand}" Background="#71CE82" HorizontalAlignment="Right"/>
    </StackPanel>


    <StackPanel Orientation="Vertical" Grid.Row= "0" Grid.Column="1" Spacing="8">
      <Button Content="Zurück" Command="{Binding NavigateHomeViewCommand}" Background="#AA3A3A" HorizontalAlignment="Right"/>
    </StackPanel>
  
    </Grid>
  </StackPanel>
</UserControl>
