<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TheraPay.UI.ViewModels"
             xmlns:domain="using:TheraPay.Domain"
             x:Class="TheraPay.UI.Views.PatientsView"
             x:DataType="vm:PatientsViewModel">

  <StackPanel Margin="16" Spacing="8">

    <TextBlock Text="Patients" FontSize="18"/>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox Width="160" Watermark="First name" Text="{Binding FirstName}"/>
      <TextBox Width="160" Watermark="Last name"  Text="{Binding LastName}"/>
      <TextBox Width="160" Watermark="Patient ID" Text="{Binding PatientID}"/>
      <Button Content="Add" Click="Add_Click"/>
    </StackPanel>

    <ListBox ItemsSource="{Binding Patients}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="domain:Patient">
          <TextBlock Text="{Binding LastName}"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </StackPanel>
</UserControl>