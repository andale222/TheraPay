<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TheraPay.UI.ViewModels.Panels"
             xmlns:dataGrid="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="TheraPay.UI.Views.Panels.CalendarPanelView"
             x:DataType="vm:CalendarPanelViewModel">

  <!-- Kalender mit anstehenden Terminen -->
  <StackPanel Spacing="12">
    <TextBlock Text="Termine:" FontSize="18" FontWeight="Bold"/>
    <Calendar/>
  </StackPanel>
</UserControl>