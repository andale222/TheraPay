<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TheraPay.UI.ViewModels"
             xmlns:domain="using:TheraPay.Domain"
             xmlns:dataGrid="using:Avalonia.Controls"
             xmlns:panels="clr-namespace:TheraPay.UI.Views.Panels"
             x:Class="TheraPay.UI.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    
    <Grid ColumnDefinitions="2*,1*" Margin="16" ColumnSpacing="16" RowDefinitions="Auto,*" >
        <!-- Left: Calendar + label -->
    
    <!-- Calendar + label -->
     <panels:CalendarPanelView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1"
                          DataContext="{Binding CalendarPanel}" />
    
    <!-- Right: action groups -->
    <StackPanel Grid.Row= "0" Grid.Column="1" Spacing="12">

      <!-- Group 1 -->
      <HeaderedContentControl>
        <HeaderedContentControl.Header>
        <TextBlock
            Text="Actions:"
            FontSize="18"
            FontWeight="Bold" />
    </HeaderedContentControl.Header>
    <Border
        Margin="0,8,0,0"
        Padding="12"
        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="8" Margin="8">
          <Button Content="Patient:in hinzufügen" Command="{Binding NavigatePatientsCommand}"/>
          <Button Content="Termin hinzufügen" Command="{Binding NavigateEditAppointmentCommand}" />
          <Button Content="Rechnungen erstellen" Command= "{Binding NavigateInvoiceCreationCommand}" />
        </StackPanel>
    </Border>
</HeaderedContentControl>

<!-- Under-group / status area -->
      <HeaderedContentControl>
        <HeaderedContentControl.Header>
        <TextBlock
            Text="Status:"
            FontSize="18"
            FontWeight="Bold" />
    </HeaderedContentControl.Header>
    <Border
        Margin="0,8,0,0"
        Padding="12"
        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="6" Margin="8">
          <TextBlock Text="Overdue invoices: 0"/>
          <TextBlock Text="Upcoming appointments: 0"/>
        </StackPanel>
    </Border>
</HeaderedContentControl>


      <HeaderedContentControl>
        <HeaderedContentControl.Header>
        <TextBlock
            Text="Speichern:"
            FontSize="18"
            FontWeight="Bold" />
    </HeaderedContentControl.Header>
    <Border
        Margin="0,8,0,0"
        Padding="12"
        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="6" Margin="8">
          <Button Content="Daten speichern" Command="{Binding SaveDataCommand}" Background="#71CE82" />
          <TextBlock Text="{Binding SaveStatusMessage}" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</HeaderedContentControl>

    </StackPanel>


    <!-- Patientenlisten Box mit mini filter -->
     <panels:PatientPanelView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          DataContext="{Binding PatientsPanel}" />

    </Grid>
</UserControl>
