<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TheraPay.UI.ViewModels"
             xmlns:domain="using:TheraPay.Domain"
             xmlns:dataGrid="using:Avalonia.Controls"
             xmlns:panels="clr-namespace:TheraPay.UI.Views.Panels"
             x:Class="TheraPay.UI.Views.AppointmentEditView"
             x:DataType="vm:AppointmentEditViewModel">

  <StackPanel Margin="16" Spacing="8">
    <TextBlock Text="{Binding ViewTitle}" FontSize="18"/>

    <Grid ColumnDefinitions="6*,5*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12" ColumnSpacing="12">

    <panels:CalendarPanelView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1"
                          DataContext="{Binding CalendarPanel}" />
    <panels:PatientPanelView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1"
                          DataContext="{Binding PatientsPanel}" />

    <StackPanel Spacing="8" Grid.Row="0" Grid.Column="1" Orientation="Vertical" >
        <TextBlock Text="Termindetails" FontSize="16"/>

        <StackPanel Spacing="8"  Orientation="Horizontal" >
            <StackPanel Spacing="8" Orientation="Vertical" >
                <TextBlock Text="Datum und Uhrzeit:"/>
                <StackPanel Spacing="8" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" >
                <CalendarDatePicker SelectedDate="{Binding StartDate}" Width="120" SelectedDateFormat="Custom" CustomDateFormatString="dd.MM.yyyy" Watermark="dd.MM.yyyy"/>
                 <!-- <MaskedTextBox Width="50" Mask="00:00" Text="{Binding StartTime, StringFormat={}{0:HH:mm}}" /> -->
                <TimePicker MinWidth="60" ClockIdentifier="24HourClock" MinuteIncrement="5" UseSeconds="False" SelectedTime="{Binding StartTime}"/>
                <TextBlock Text=" bis "/>
                <TimePicker MinWidth="60" ClockIdentifier="24HourClock" MinuteIncrement="5" UseSeconds="False" SelectedTime="{Binding EndTime}"/>
                <!-- <MaskedTextBox Width="50" Mask="00:00" Text="{Binding StartTime, StringFormat={}{0:HH:mm}}" /> -->
                <TextBlock Text="{Binding DurationInMinutes, StringFormat='Dauer: {0} min'}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>


        <StackPanel Spacing="8" Orientation="Vertical" >
            <TextBlock Text="Abrechnungsnummern:"/>
            <StackPanel Spacing="8" Orientation="Horizontal" >
                <ComboBox ItemsSource="{Binding AvailableBillingNumbers}"
                          SelectedItem="{Binding SelectedBillingNumber}"
                          Width="520">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="domain:BillingNumber">
                            <Grid Width="490" ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding NumberIdentifier}" FontWeight="Bold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Type}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:0.00} €'}"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,1*,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SelectedBillingNumber.NumberIdentifier, StringFormat='Nummer: {0}'}" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedBillingNumber.Type, StringFormat='Typ: {0}'}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Faktor:"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding DraftFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Basisbetrag:"/>
                <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding DraftBaseValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Bezeichnung:"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
                         Text="{Binding DraftDescription, Mode=TwoWay}"
                         Width="410"
                         Height="60"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"/>
            </Grid>
            <StackPanel Spacing="8" Orientation="Horizontal" >
                <Button Content="Hinzufügen" Command="{Binding AddBillingNumberCommand}" MinWidth="110"/>
                <Button Content="Entfernen" Command="{Binding RemoveBillingNumberCommand}" MinWidth="100"/>
                <TextBlock Text="Entwurfsbetrag:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Text="{Binding DraftAmountPreview, StringFormat='{}{0:0.00} €'}" VerticalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding AssignedBillingNumbers}"
                     SelectedItem="{Binding SelectedAssignedBillingNumber}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     Height="120"
                     Width="520">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:BillingNumber">
                        <Grid ColumnDefinitions="40,60,40,40,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding NumberIdentifier}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:0.00} €'}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding Type}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Factor, StringFormat='F: {0:0.##}'}"/>
                            <TextBlock Grid.Column="4" Text="{Binding Description}" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Spacing="8" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Gesamtbetrag:" FontWeight="Bold"/>
                <TextBlock Text="{Binding TotalAmountPreview, StringFormat='{}{0:0.00} €'}" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

    </StackPanel>


            <!-- Buttons -->
            <StackPanel Grid.Row="1" Grid.Column="1"  Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <Button Content="Prüfen" Command="{Binding CheckDataCommand}" Background="#c77f21" MinWidth="100"/>
                <Button Content="{Binding SaveButtonText}" Command="{Binding SaveAppointmentCommand}" Background="#71CE82" MinWidth="150"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Margin="0,72,0,0"
                       HorizontalAlignment="Right"
                       MaxWidth="360"/>
            <StackPanel Grid.Row="1" Grid.Column="1"  Orientation="Horizontal" Margin="0,30,16,0" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Right">
                <Button Content="Zurück" Command="{Binding NavigateHomeViewCommand}" Background="#FF6B6B" MinWidth="100"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1"  Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Left">
                <StackPanel Spacing="8" Orientation="Vertical" Margin="0,30,16,0">
                    <TextBlock Text="Patientendaten:" FontSize="20" />
                    <TextBlock Text="{Binding PatientsPanel.SelectedPatient.Id, StringFormat='ID: {0}', TargetNullValue='ID: -'}" FontSize="16" />
                    <TextBlock Text="{Binding PatientsPanel.SelectedPatient.Vorname, StringFormat='Vorname: {0}', TargetNullValue='Vorname: -'}" FontSize="16" />
                    <TextBlock Text="{Binding PatientsPanel.SelectedPatient.Name, StringFormat='Nachname: {0}', TargetNullValue='Nachname: -'}" FontSize="16" />
                    <TextBlock Text="{Binding PatientsPanel.SelectedPatient.Geburtsdatum, StringFormat='Geburtsdatum: {0}', TargetNullValue='Geburtsdatum: -'}" FontSize="16" />
                    <TextBlock Text="{Binding PatientsPanel.SelectedPatient.Versicherungsart, StringFormat='Versicherungsart: {0}', TargetNullValue='Versicherungsart: -'}" FontSize="16" />
                </StackPanel>
            </StackPanel>
        </Grid>
  </StackPanel>
</UserControl>
